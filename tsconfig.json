{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true
  },
  "include": ["apps/service/**/*.ts", "packages/**/*.ts", "fixtures/**/*.ts", "tests/**/*.ts", "playwright.config.ts"]
}
