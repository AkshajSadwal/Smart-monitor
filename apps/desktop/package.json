{
  "name": "@monitor/desktop",
  "productName": "Smart Monitor",
  "desktopName": "smart-monitor.desktop",
  "version": "0.1.0",
  "private": true,
  "main": "main.cjs",
  "description": "Local-first topic and post monitoring",
  "homepage": "https://github.com/AkshajSadwal/Smart-monitor",
  "author": "Smart Monitor contributors",
  "scripts": {
    "start": "electron ."
  },
  "build": {
    "appId": "local.smartmonitor.app",
    "directories": {
      "output": "../../release"
    },
    "files": [
      "main.cjs",
      "account.cjs",
      "tray.png",
      "package.json",
      {
        "from": "../../dist",
        "to": "worker",
        "filter": [
          "monitor.mjs"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "../../apps/web/out",
        "to": "web"
      }
    ],
    "asarUnpack": [
      "**/*.node",
      "**/node-notifier/vendor/**"
    ],
    "win": {
      "icon": "tray.png",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "icon": "tray.png",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Utility",
      "maintainer": "Smart Monitor contributors"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Smart Monitor",
      "include": "installer.nsh"
    },
    "npmRebuild": true
  },
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "@napi-rs/keyring": "^1.0.0",
    "better-sqlite3": "^12.0.0",
    "electron-updater": "^6.8.11",
    "fastify": "^5.0.0",
    "node-notifier": "^12.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  }
}
